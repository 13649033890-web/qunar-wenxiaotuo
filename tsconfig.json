{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "DOM",
      "ESNext"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "types": [
      "vite/client"
    ]
  },
  "include": [
    "src",
    "app/page.tsx",
    "vite.config.ts"
  ]
}